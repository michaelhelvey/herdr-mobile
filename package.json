{
  "name": "herdr-mobile",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch ./src/server/main.ts",
    "build": "bun build --compile --production --outfile dist/herdr-bridge ./src/server/main.ts",
    "check": "rs check --type-check",
    "format": "rs fmt",
    "lint": "rs lint",
    "test": "bun test",
    "typecheck": "tsc",
    "prepare": "rs hooks",
    "validate": "bun run format && bun run --parallel check test",
    "icons": "bun scripts/icons.ts",
    "start": "./dist/herdr-bridge"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.0",
    "preact": "^11.0.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.2",
    "rstack": "^0.8.1",
    "typescript": "^7.0.2"
  }
}
